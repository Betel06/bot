//@version=5
indicator("SMC 2TF: Setup H1 + Correcacao (reteste validado)", overlay=true, max_boxes_count=500, max_labels_count=200)

// ==========================================
// 1. CONFIG
// ==========================================
pivot_len = input.int(10, title="Velas p/ pivo no setup (H1, esq+dir)")
periodo_candles = input.int(200, title="EMA/ref no setup (H1)")
tf_setup = input.timeframe("60", title="Timeframe do setup (H1)")
ver_ema200 = input.bool(true, title="Mostrar EMA 200 (H1)")

micro_len = input.int(3, title="Pivo micro da correcao (TF do grafico)", minval=2, maxval=10)

usar_vol_filtro = input.bool(true, title="Exigir volume no sinal")
vol_filtro_mult = input.float(1.2, title="Volume minimo (x media 20)", minval=0.0, step=0.1)

usar_macd = input.bool(true, title="Confirmar com MACD (macd x signal)")
usar_rsi_valid = input.bool(true, title="Validar rompimento do pivo com RSI (50)")
rsi_len = input.int(14, title="Comprimento do RSI", minval=2, maxval=50)
reteste_tol = input.float(0.15, title="Tolerancia do reteste (x ATR14)", minval=0.0, step=0.05)

armado_velas = input.int(10, title="Velas para o reteste depois de romper", minval=2, maxval=30)
cooldown_velas = input.int(6, title="Velas de espera entre sinais", minval=0, maxval=20)
usar_ema_filtro = input.bool(true, title="Sesgo exige preco na direcao da EMA 200 (H1)")

mostrarOB = input.bool(false, title="Mostrar Order Blocks")
mostrarFVG = input.bool(false, title="Mostrar FVGs")
obImpulseMult = input.float(1.0, "Forca minima do candle p/ OB (x do corpo medio)", minval=0.3, step=0.1)
mitigacaoPorFechamento = input.bool(false, "Mitigar zona so pelo fechamento (senao, pavio ja mitiga)")

corOBBull  = color.new(color.teal, 65)
corOBBear  = color.new(color.maroon, 65)
corFVGBull = color.new(color.blue, 85)
corFVGBear = color.new(color.orange, 85)

// ==========================================
// 2. ESTRUTURA COMPUTADA NO TIMEFRAME DE SETUP (H1)
// ==========================================
calc_estrutura_h1() =>
    var string tend_h1 = "Indefinida"
    var float ctop = na
    var float cfund = na
    hh = ta.highest(high, periodo_candles)
    ll = ta.lowest(low, periodo_candles)
    if na(ctop) and not na(hh)
        ctop := hh
        cfund := ll
    ph = ta.pivothigh(high, pivot_len, pivot_len)
    pl = ta.pivotlow(low, pivot_len, pivot_len)
    if not na(ph)
        if tend_h1 == "Baixa"
            meio = na(ctop) or na(cfund) ? na : (ctop + cfund) / 2
            if na(ctop) or (not na(meio) and ph >= meio)
                ctop := ph
        else
            if na(ctop) or (tend_h1 != "Alta" or ph > ctop)
                ctop := ph
    if not na(pl)
        if tend_h1 == "Alta"
            meio = na(ctop) or na(cfund) ? na : (ctop + cfund) / 2
            if na(cfund) or (not na(meio) and pl <= meio)
                cfund := pl
        else
            if na(cfund) or (tend_h1 != "Baixa" or pl < cfund)
                cfund := pl
    if ta.crossover(close, ctop)
        tend_h1 := "Alta"
    if ta.crossunder(close, cfund)
        tend_h1 := "Baixa"
    tendnum = tend_h1 == "Alta" ? 1 : tend_h1 == "Baixa" ? -1 : 0
    topo = na(ctop) ? hh : ctop
    fundo = na(cfund) ? ll : cfund
    [topo, fundo, tendnum]

[h1_topo, h1_fundo, h1_tend] = request.security(syminfo.tickerid, tf_setup, calc_estrutura_h1(), lookahead=barmerge.lookahead_off)
h1_close = request.security(syminfo.tickerid, tf_setup, close, lookahead=barmerge.lookahead_off)
h1_ema = request.security(syminfo.tickerid, tf_setup, ta.ema(close, periodo_candles), lookahead=barmerge.lookahead_off)

nivel_50 = (h1_topo + h1_fundo) / 2

// ==========================================
// 3. ZONAS DE ORDER BLOCK E FVG (opcionais, clean)
// ==========================================
var box[] obBoxes  = array.new_box(0)
var int[] obBars   = array.new_int(0)
var int[] obTipo   = array.new_int(0)
var box[] fvgBoxes = array.new_box(0)
var int[] fvgBars  = array.new_int(0)
var int[] fvgTipo  = array.new_int(0)

corpoMedio = ta.sma(math.abs(close - open), 20)
velaBaixa1 = close[1] < open[1]
velaAlta1  = close[1] > open[1]
rompeuAltaForte  = close > ta.highest(high[1], 5) and (close - open) > corpoMedio * obImpulseMult
rompeuBaixaForte = close < ta.lowest(low[1], 5) and (open - close) > corpoMedio * obImpulseMult

criarOB(cond, tipo, cor, borda) =>
    if mostrarOB and cond
        array.push(obBoxes, box.new(left=bar_index[1], top=high[1], bottom=low[1], right=bar_index + 1,
             bgcolor=cor, border_color=borda, border_width=1, extend=extend.right))
        array.push(obBars, bar_index)
        array.push(obTipo, tipo)

criarFVG(cond, topo, baixo, tipo, cor, borda) =>
    if mostrarFVG and cond
        array.push(fvgBoxes, box.new(left=bar_index[2], top=topo, bottom=baixo, right=bar_index + 1,
             bgcolor=cor, border_color=borda, border_width=1, extend=extend.right))
        array.push(fvgBars, bar_index)
        array.push(fvgTipo, tipo)

criarOB(velaBaixa1 and rompeuAltaForte, 1, corOBBull, color.new(color.teal, 40))
criarOB(velaAlta1 and rompeuBaixaForte, -1, corOBBear, color.new(color.maroon, 40))
criarFVG(low > high[2], low, high[2], 1, corFVGBull, color.new(color.blue, 50))
criarFVG(high < low[2], low[2], high, -1, corFVGBear, color.new(color.orange, 50))

mitigarZonas(boxes, bars, tipos) =>
    if array.size(boxes) > 0
        for i = array.size(boxes) - 1 to 0
            bx = array.get(boxes, i)
            if bar_index > array.get(bars, i)
                t = box.get_top(bx)
                btm = box.get_bottom(bx)
                tocou = mitigacaoPorFechamento ? (close <= t and close >= btm) : (high >= btm and low <= t)
                if tocou
                    box.delete(bx)
                    array.remove(boxes, i)
                    array.remove(bars, i)
                    array.remove(tipos, i)

mitigarZonas(obBoxes, obBars, obTipo)
mitigarZonas(fvgBoxes, fvgBars, fvgTipo)

// ==========================================
// 4. PIVOS DA CORRECAO (marcas tracejadas curtas)
// ==========================================
ph_m = ta.pivothigh(high, micro_len, micro_len)
pl_m = ta.pivotlow(low, micro_len, micro_len)

var line[] tpLinhas = array.new_line(0)
var float[] tpNiveis = array.new_float(0)
var line[] fdLinhas = array.new_line(0)
var float[] fdNiveis = array.new_float(0)
var float ultTopoQuebrado = na
var float ultFundoQuebrado = na

if not na(ph_m)
    array.push(tpLinhas, line.new(x1=bar_index - micro_len, y1=ph_m, x2=bar_index - micro_len + 20, y2=ph_m,
         color=color.new(color.red, 0), style=line.style_dashed, width=2))
    array.push(tpNiveis, ph_m)

if not na(pl_m)
    array.push(fdLinhas, line.new(x1=bar_index - micro_len, y1=pl_m, x2=bar_index - micro_len + 20, y2=pl_m,
         color=color.new(color.green, 0), style=line.style_dashed, width=2))
    array.push(fdNiveis, pl_m)

if array.size(tpLinhas) > 0
    for i = array.size(tpLinhas) - 1 to 0
        if close > array.get(tpNiveis, i)
            ultTopoQuebrado := array.get(tpNiveis, i)
            line.delete(array.get(tpLinhas, i))
            array.remove(tpLinhas, i)
            array.remove(tpNiveis, i)

if array.size(fdLinhas) > 0
    for i = array.size(fdLinhas) - 1 to 0
        if close < array.get(fdNiveis, i)
            ultFundoQuebrado := array.get(fdNiveis, i)
            line.delete(array.get(fdLinhas, i))
            array.remove(fdLinhas, i)
            array.remove(fdNiveis, i)

// ultimos niveis vivos (ultimo topo/fundo da correcao)
topoMi = array.size(tpNiveis) > 0 ? array.get(tpNiveis, array.size(tpNiveis) - 1) : na
fundoMi = array.size(fdNiveis) > 0 ? array.get(fdNiveis, array.size(fdNiveis) - 1) : na

// ==========================================
// 5. GATILHO 24h - rompeu pivo + RSI valida + reteste + MACD + volume
// ==========================================
brokeTopoC = not na(topoMi) and close > topoMi
brokeFundoC = not na(fundoMi) and close < fundoMi
temCorrecao = not na(topoMi) and not na(fundoMi)

atrV = ta.atr(14)
var float topoRote = na
var float fundoRote = na
retesteLongo = not na(topoRote) and low <= topoRote + atrV * reteste_tol and close > topoRote
retesteCurto = not na(fundoRote) and high >= fundoRote - atrV * reteste_tol and close < fundoRote

[macdLine, signalLine, macdHist] = ta.macd(close, 12, 26, 9)
revLong = ta.crossover(macdLine, signalLine)
revShort = ta.crossunder(macdLine, signalLine)

rsiV = ta.rsi(close, rsi_len)
rsiAlta = rsiV >= 50
rsiBaixa = rsiV <= 50

volumeMedio = ta.sma(volume, 20)
volumeForte = volume >= volumeMedio * vol_filtro_mult

sesgoLongo = h1_tend == 1 and (not usar_ema_filtro or h1_close > h1_ema)
sesgoCurto = h1_tend == -1 and (not usar_ema_filtro or h1_close < h1_ema)

var int armadoLong = 0
var int armadoShort = 0

condLongo = sesgoLongo and armadoLong > 0 and retesteLongo and (not usar_macd or revLong) and (not usar_vol_filtro or volumeForte)
condCurto = sesgoCurto and armadoShort > 0 and retesteCurto and (not usar_macd or revShort) and (not usar_vol_filtro or volumeForte)

if temCorrecao and brokeTopoC and not brokeFundoC and (not usar_rsi_valid or rsiAlta)
    armadoLong := armado_velas
    armadoShort := 0
    topoRote := ultTopoQuebrado
else if temCorrecao and brokeFundoC and not brokeTopoC and (not usar_rsi_valid or rsiBaixa)
    armadoShort := armado_velas
    armadoLong := 0
    fundoRote := ultFundoQuebrado
else if brokeFundoC
    armadoLong := 0
    topoRote := na
else if brokeTopoC
    armadoShort := 0
    fundoRote := na
else
    armadoLong := armadoLong > 0 ? armadoLong - 1 : 0
    armadoShort := armadoShort > 0 ? armadoShort - 1 : 0
    if armadoLong == 0
        topoRote := na
    if armadoShort == 0
        fundoRote := na

var int delaySinal = 0
delaySinal := delaySinal + 1
gatLongo = delaySinal >= cooldown_velas and condLongo and not condLongo[1]
gatCurto = delaySinal >= cooldown_velas and condCurto and not condCurto[1]
if gatLongo or gatCurto
    delaySinal := 0

// stop do movimento
stopLong = na(fundoMi) ? low : fundoMi
stopShort = na(topoMi) ? high : topoMi

// ==========================================
// 6. VISUAL
// ==========================================
pTop = plot(not na(h1_topo) ? h1_topo : na, "Topo setup (H1)", color=color.new(color.red, 25), linewidth=2, style=plot.style_stepline)
pFnd = plot(not na(h1_fundo) ? h1_fundo : na, "Fundo setup (H1)", color=color.new(color.green, 25), linewidth=2, style=plot.style_stepline)
fill(pTop, pFnd, color=color.new(color.blue, 97))
plot(not na(nivel_50) ? nivel_50 : na, "Nivel 50% (H1)", color=color.new(color.orange, 35), linewidth=2, style=plot.style_linebr)
plot(ver_ema200 and not na(h1_ema) ? h1_ema : na, "EMA 200 (H1)", color=color.new(color.navy, 25), linewidth=2, style=plot.style_linebr)

plotshape(not na(ph_m), "Pivo alto micro", style=shape.circle, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny, offset=-micro_len)
plotshape(not na(pl_m), "Pivo baixo micro", style=shape.circle, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny, offset=-micro_len)

if gatLongo
    label.new(bar_index, low, "LONG @" + str.tostring(close, format.mintick), style=label.style_label_up,
         color=color.new(color.teal, 0), textcolor=color.white, size=size.small)
if gatCurto
    label.new(bar_index, high, "SHORT @" + str.tostring(close, format.mintick), style=label.style_label_down,
         color=color.new(color.red, 0), textcolor=color.white, size=size.small)

alertcondition(gatLongo, title="LONG 24h (rompeu pivo + reteste)", message="LONG")
alertcondition(gatCurto, title="SHORT 24h (rompeu pivo + reteste)", message="SHORT")

if gatLongo
    alert("LONG " + syminfo.tickerid + " @ " + str.tostring(close, format.mintick) + " | zona50 H1 " + str.tostring(nivel_50, format.mintick) + " | Stop " + str.tostring(stopLong, format.mintick) + " | Alvo " + str.tostring(h1_topo, format.mintick), alert.freq_once_per_bar_close)
if gatCurto
    alert("SHORT " + syminfo.tickerid + " @ " + str.tostring(close, format.mintick) + " | zona50 H1 " + str.tostring(nivel_50, format.mintick) + " | Stop " + str.tostring(stopShort, format.mintick) + " | Alvo " + str.tostring(h1_fundo, format.mintick), alert.freq_once_per_bar_close)